# Firebase Hosting origin that serves /puzzles/manifest.json and /puzzles/*.json.
# Leave unset to load the local public/puzzles files during development.
VITE_PUZZLE_PACK_BASE_URL=https://crossword-puzzle-79ae0.web.app

# Optional full manifest URL override. Use only when the manifest is not at
# <VITE_PUZZLE_PACK_BASE_URL>/puzzles/manifest.json.
# VITE_PUZZLE_MANIFEST_URL=https://crossword-puzzle-79ae0.web.app/puzzles/manifest.json

# Optional app landing link appended to the result share text (viral loop, #227).
# Set a per-market entry/deep-link URL so shared results carry a "따라 할 링크".
# Leave unset to omit the link line (share text stays byte-identical to before).
# VITE_SHARE_LANDING_URL=https://crossword-puzzle-79ae0.web.app

# Firebase Web app config for Analytics and Remote Config.
# Leave unset to run the app with local defaults and no Firebase client SDK.
# VITE_FIREBASE_API_KEY=AIzaSyCepAAC_iTRar-AntpajHNw43J4QYjhkXQ
# VITE_FIREBASE_AUTH_DOMAIN=crossword-puzzle-79ae0.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=crossword-puzzle-79ae0
# VITE_FIREBASE_STORAGE_BUCKET=crossword-puzzle-79ae0.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=547625965706
# VITE_FIREBASE_APP_ID=1:547625965706:web:8f8fa055d837c90e9ef573
# VITE_FIREBASE_MEASUREMENT_ID=G-Y76PEDZ32X

# 자체 지표 서버(선택). 설정하면 게임/텔레메트리 이벤트를 Firebase/AppsInToss 와 함께
# 이 엔드포인트로도 POST 한다(sendBeacon 우선). 미설정이면 자체 서버 sink 는 비활성.
# 지표 백엔드를 자체 서버로 전환/병행할 때 이 값만 채우면 된다(코드 변경 불필요).
# VITE_METRICS_ENDPOINT=https://metrics.seorilabs.example/collect
