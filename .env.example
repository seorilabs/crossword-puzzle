# Firebase Hosting origin that serves /puzzles/manifest.json and /puzzles/*.json.
# Leave unset to load the local public/puzzles files during development.
VITE_PUZZLE_PACK_BASE_URL=https://crossword-puzzle-79ae0.web.app

# Optional full manifest URL override. Use only when the manifest is not at
# <VITE_PUZZLE_PACK_BASE_URL>/puzzles/manifest.json.
# VITE_PUZZLE_MANIFEST_URL=https://crossword-puzzle-79ae0.web.app/puzzles/manifest.json