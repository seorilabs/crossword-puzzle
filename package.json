{
  "name": "crossword-puzzle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "granite dev",
    "build": "ait build",
    "deploy": "ait deploy",
    "test:adapters": "node --experimental-strip-types --test src/adapters/*.test.mts",
    "test:core": "node --experimental-strip-types --test packages/crossword-core/src/*.test.mts",
    "test:components": "vitest run",
    "test:first-run-playthrough": "vitest run src/game-shell/firstRunPlaythrough.test.tsx src/game-shell/firstRunPlaythrough.ui.test.tsx",
    "test:game": "node --experimental-strip-types --test src/game-shell/*.test.mts packages/crossword-game/src/*.test.mts",
    "test:save-migration": "node --experimental-strip-types --test packages/crossword-core/src/legacySaveMigration.test.mts src/game-shell/gameSaveMigration.test.mts src/adapters/legacyWebSaveInventory.test.mts && npm --prefix apps/mobile test -- --watchAll=false --runTestsByPath __tests__/legacyMobileSaveInventory.test.ts",
    "test:game-assets": "node --test scripts/build-native-game-bundle.test.mjs",
    "check:game": "npm run test:game && npm run test:first-run-playthrough && npm run test:game-assets && tsc -p packages/crossword-game/tsconfig.json && tsc -p src/game-shell/tsconfig.json",
    "build:game:mobile": "node scripts/build-native-game-bundle.mjs build",
    "check:game-assets": "node scripts/build-native-game-bundle.mjs check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "mobile:install": "npm ci --prefix apps/mobile",
    "mobile:start": "npm --prefix apps/mobile run start",
    "mobile:android": "npm --prefix apps/mobile run android",
    "mobile:ios": "npm --prefix apps/mobile run ios",
    "check:mobile": "npm --prefix apps/mobile run lint && npm --prefix apps/mobile run typecheck && npm --prefix apps/mobile test -- --watchAll=false",
    "test:firebase-config-restore": "node --test scripts/restore-mobile-firebase-config.test.mjs",
    "check:release-parity": "node scripts/check-release-parity.mjs && npm run check:theme-review && npm run test:launch-content-builder && npm run test:save-migration && npm run build:game:mobile && npm run test:firebase-config-restore",
    "build:android": "cd apps/mobile/android && ./gradlew :app:bundleRelease --no-daemon",
    "check:play": "node scripts/check-google-play-readiness.mjs",
    "play:onboard:repo": "scripts/setup-google-play-wif.sh",
    "play:listing:dry-run": "python3 scripts/apply-google-play-listing.py --dry-run --allow-missing-tablet",
    "play:listing:apply": "python3 scripts/apply-google-play-listing.py --apply --replace-images --allow-missing-tablet",
    "play:listing:verify": "python3 scripts/apply-google-play-listing.py --verify --allow-missing-tablet",
    "check:app-store": "node scripts/check-app-store-readiness.mjs",
    "app-store:deliver:prepare": "node scripts/prepare-app-store-deliver-assets.mjs",
    "app-store:deliver:upload": "scripts/app-store-local-deliver.sh",
    "app-store:metadata:upload": "sh -c 'cd apps/mobile && (bundle check >/dev/null 2>&1 || bundle install) && bundle exec ruby ../../scripts/app-store-connect-upload-metadata.rb \"$@\"' --",
    "app-store:build:local": "scripts/app-store-local-build.sh",
    "play:upload:internal": "python3 scripts/upload-google-play-internal.py",
    "release:next-tag": "node scripts/next-release-tag.mjs",
    "release:resolve-version": "node scripts/resolve-release-version.mjs",
    "batch:puzzles": "node server/batch/generate-puzzle-pack.mjs",
    "job:puzzle-pack": "node server/batch/run-puzzle-pack-job.mjs",
    "publish:puzzles": "node server/batch/publish-puzzle-pack.mjs",
    "prototype:crossword": "node scripts/crossword-generator-prototype.mjs",
    "validate:puzzles": "node scripts/validate-puzzle-pack.mjs",
    "clues:apply": "node scripts/apply-manual-clues.mjs",
    "wordbank:krdict": "node scripts/build-krdict-wordbank.mjs",
    "wordbank:themes": "node scripts/build-theme-tags.mjs",
    "content:candidates": "node --experimental-strip-types scripts/build-launch-content-candidates.mjs",
    "content:review": "node --experimental-strip-types scripts/build-reviewed-launch-wordbank.mjs",
    "content:theme-review": "node --experimental-strip-types scripts/build-launch-theme-wordbank.mjs",
    "check:theme-review": "node --experimental-strip-types scripts/build-launch-theme-wordbank.mjs --check",
    "check:krdict-provenance": "node --experimental-strip-types scripts/verify-krdict-launch-provenance.mjs",
    "test:launch-content-builder": "node --experimental-strip-types --test server/batch/generate-puzzle-pack.test.mjs server/batch/puzzle-board-engine.test.mjs scripts/build-launch-theme-wordbank.test.mjs scripts/build-ko-kr-launch-content.test.mjs scripts/compact-crossword-generator.test.mjs scripts/crossword-generator-prototype.test.mjs scripts/launch-board-review-ledger.test.mjs scripts/launch-board-review-workbook.test.mjs scripts/validate-ko-kr-launch-content.test.mjs",
    "build:launch-content": "node --experimental-strip-types scripts/build-ko-kr-launch-content.mjs",
    "content:board-review:prepare": "node --experimental-strip-types scripts/launch-board-review-workbook.mjs prepare",
    "content:board-review:assemble": "node --experimental-strip-types scripts/launch-board-review-workbook.mjs assemble",
    "check:launch-content": "npm run check:krdict-provenance && node --experimental-strip-types scripts/validate-ko-kr-launch-content.mjs"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "^2.6.0",
    "@emotion/react": "^11.14.0",
    "@toss/tds-colors": "^0.1.0",
    "@toss/tds-mobile": "^2.3.0",
    "@toss/tds-mobile-ait": "^2.3.0",
    "firebase": "^12.14.0",
    "phaser": "4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fast-xml-parser": "^5.8.0",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vitest": "^4.1.9"
  }
}
