{
  "schemaVersion": 1,
  "features": [
    {
      "id": "daily-puzzle-delivery",
      "core": true,
      "paths": [
        "src/adapters/staticPuzzleRepository.ts",
        "packages/crossword-core/src/daily*.ts",
        "packages/crossword-core/src/continuousPlay.ts"
      ]
    },
    {
      "id": "crossword-play",
      "core": true,
      "paths": [
        "src/App.tsx",
        "src/components/PuzzleBoard.tsx",
        "apps/mobile/App.tsx",
        "packages/crossword-core/src/answerInput.ts",
        "src/components/TilePuzzleScreen.tsx",
        "apps/mobile/TilePuzzleScreen.tsx",
        "packages/crossword-core/src/letterTileInput.ts"
      ]
    },
    {
      "id": "progress-and-archive",
      "core": true,
      "paths": [
        "src/adapters/localProgressRepository.ts",
        "apps/mobile/puzzleArchive.ts",
        "src/adapters/localPuzzleAccessRepository.ts"
      ]
    },
    {
      "id": "results-and-share",
      "core": true,
      "paths": [
        "src/useShareResult.ts",
        "src/components/ShareGridPreview.tsx",
        "apps/mobile/shareResult.ts",
        "apps/mobile/TileResultScreen.tsx"
      ]
    },
    {
      "id": "records-leaderboard",
      "core": false,
      "paths": [
        "src/useLeaderboard.ts",
        "src/components/PersonalStatsCard.tsx",
        "src/components/StreakHeatmap.tsx",
        "apps/mobile/recordsComponents.tsx"
      ]
    },
    {
      "id": "settings-and-help",
      "core": false,
      "paths": [
        "src/components/SettingsSheet.tsx",
        "src/components/HowToPlayDialog.tsx",
        "src/adapters/feedbackSettingsRepository.ts"
      ]
    },
    {
      "id": "return-reminder",
      "core": false,
      "paths": [
        "src/adapters/returnReminderRepository.ts",
        "packages/crossword-core/src/returnReminder.ts",
        "apps/mobile/returnReminderRepository.ts"
      ]
    },
    {
      "id": "puzzle-pack-generation",
      "core": true,
      "paths": [
        "server/batch/generate-puzzle-pack.mjs",
        "server/batch/run-puzzle-pack-job.mjs",
        "server/batch/publishedLegacyState.mjs",
        "server/batch/publish-puzzle-pack.mjs",
        "scripts/validate-puzzle-pack.mjs",
        "server/batch/generate-language-packs.mjs",
        "server/batch/fillCrosswordTemplate.mjs",
        "server/batch/run-language-pack-job.mjs",
        "data/puzzles/daily-board-templates.json",
        "data/lexicon/en-wordbank.json",
        "data/lexicon/ko-daily-clues.json",
        "server/batch/publishedPackVisibility.mjs"
      ],
      "runtimeKind": "service"
    },
    {
      "id": "puzzle-image-retention",
      "core": false,
      "paths": [
        "server/batch/imageRetention.mjs",
        "scripts/deploy-puzzle-pack-image.mjs",
        "scripts/preview-puzzle-image-cleanup.mjs",
        "scripts/setup-puzzle-pack-cloud-run-job.sh",
        "config/puzzle-image-cleanup.json"
      ],
      "runtimeKind": "service"
    },
    {
      "id": "puzzle-pack-monitoring",
      "core": false,
      "paths": [
        "scripts/setup-puzzle-pack-monitoring.sh",
        "server/batch/check-puzzle-pack-health.mjs",
        "server/batch/publishedPackVisibility.mjs",
        "server/batch/languagePackHealth.mjs",
        "server/batch/languagePackValidation.mjs"
      ],
      "runtimeKind": "service"
    },
    {
      "id": "platform-auth",
      "core": false,
      "foundation": true,
      "paths": [
        "src/adapters/platformAuth.ts",
        "src/adapters/firebaseClient.ts",
        "apps/mobile/platformAuth.ts",
        "apps/mobile/firebaseClient.ts"
      ]
    },
    {
      "id": "platform-ads",
      "core": false,
      "foundation": true,
      "paths": [
        "apps/mobile/mobileAds.ts",
        "apps/mobile/ios/CrosswordPuzzleMobile/ConsentPreferences.swift",
        "apps/mobile/ios/CrosswordPuzzleMobile/AppDelegate.swift",
        "apps/mobile/firebase.json",
        "src/adapters/completionInterstitial.ts",
        "apps/mobile/completionInterstitial.ts",
        "packages/crossword-core/src/completionInterstitial.ts"
      ]
    },
    {
      "id": "remote-configuration",
      "core": false,
      "foundation": true,
      "paths": [
        "src/adapters/launchConfig.ts"
      ]
    },
    {
      "id": "analytics",
      "core": false,
      "foundation": true,
      "paths": [
        "src/adapters/telemetry.ts",
        "src/adapters/gameAnalytics.ts",
        "apps/mobile/gameplayTelemetry.ts",
        "apps/mobile/telemetry.ts",
        "apps/mobile/gameAnalytics.ts",
        "src/adapters/analyticsSinks.ts",
        "apps/mobile/analyticsSinks.ts",
        "packages/crossword-core/src/gameAnalytics.ts",
        "packages/crossword-core/src/dailyLanguage.ts"
      ]
    },
    {
      "id": "daily-vocabulary-selection",
      "core": true,
      "paths": [
        "packages/crossword-core/src/vocabularySelection.ts",
        "scripts/crossword-generator-prototype.mjs"
      ],
      "runtimeKind": "service"
    },
    {
      "id": "first-puzzle-guidance",
      "core": true,
      "paths": [
        "packages/crossword-core/src/firstWordGuide.ts",
        "apps/mobile/TilePuzzleScreen.tsx",
        "src/components/TilePuzzleScreen.tsx"
      ]
    },
    {
      "id": "syllable-tile-input",
      "core": true,
      "paths": [
        "packages/crossword-core/src/letterTileInput.ts",
        "apps/mobile/TilePuzzleScreen.tsx",
        "src/components/TilePuzzleScreen.tsx"
      ]
    },
    {
      "id": "puzzle-progress-persistence",
      "core": true,
      "paths": [
        "src/adapters/localProgressRepository.ts",
        "apps/mobile/App.tsx",
        "packages/crossword-core/src/letterTileInput.ts"
      ]
    },
    {
      "id": "usage-statistics-preference",
      "core": false,
      "paths": [
        "packages/crossword-core/src/usageStatistics.ts",
        "src/adapters/usageStatistics.ts",
        "apps/mobile/usageStatistics.ts"
      ]
    },
    {
      "id": "bilingual-five-daily",
      "core": true,
      "paths": [
        "packages/crossword-core/src/dailyLanguage.ts",
        "server/batch/generate-language-packs.mjs",
        "src/adapters/languageRepository.ts",
        "apps/mobile/languageRepository.ts"
      ]
    }
  ]
}
